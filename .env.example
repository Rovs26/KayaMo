# ── Supabase ───────────────────────────────────────────────────────────────
# Local: npx supabase start && npx supabase status  → paste URL + keys below.
# Never put SUPABASE_SERVICE_ROLE_KEY in a client bundle.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Opt in only against a disposable/local project; RLS tests create auth users.
RUN_DB_TESTS=0

# Google OAuth (Auth). Enable [auth.external.google] in supabase/config.toml
# after these are set. Distinct from Calendar OAuth below.
GOOGLE_AUTH_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ── Nutrition data ─────────────────────────────────────────────────────────
USDA_FDC_API_KEY=                   # free from api.data.gov
OFF_USER_AGENT=KayaMo/1.0 (contact@kayamo.ph)   # Open Food Facts requires this

# ── AI model routing (Chapter 17) ──────────────────────────────────────────
OPENAI_API_KEY=                     # server-only; never prefix with NEXT_PUBLIC_
ELEVENLABS_API_KEY=                 # server-only; reserved for later voice output
MODEL_NANO=                         # intent classification, unit parsing
MODEL_SMALL=                        # Taglish extraction, OCR structuring
MODEL_VISION=gpt-5.4-mini           # photo / nutrition-label OCR
MODEL_COACH=                        # weekly narrative only
MODEL_EMBED=
AI_DAILY_BUDGET_USD_PER_USER=0.05
AI_ESTIMATED_REQUEST_USD=0.01
MODEL_INPUT_USD_PER_MILLION=0       # set from the selected model's current pricing
MODEL_OUTPUT_USD_PER_MILLION=0
PHOTO_ANALYSES_PER_DAY=10

# ── Optional integrations ──────────────────────────────────────────────────
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# ── Push ───────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=       # same public key; safe for browser subscription
VAPID_PRIVATE_KEY=

# ── Observability ──────────────────────────────────────────────────────────
SENTRY_DSN=
POSTHOG_KEY=
