{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@kayamo/db": ["./packages/db/src"],
      "@kayamo/db/*": ["./packages/db/src/*"],
      "@kayamo/core": ["./packages/core/src"],
      "@kayamo/food": ["./packages/food/src"],
      "@kayamo/food/ph-core": ["./packages/food/src/ph-core-browser.ts"],
      "@kayamo/ai": ["./packages/ai/src"],
      "@kayamo/offline": ["./packages/offline/src"],
      "@kayamo/features": ["./packages/features/src"],
      "@kayamo/ui": ["./packages/ui/src"],
      "@kayamo/mobile/native": ["./apps/mobile/src/native/index.ts"]
    }
  }
}
